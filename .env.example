# Copiar a .env y ajustar.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos del sistema contable (MariaDB/MySQL). Solo se hacen lecturas.
VADMON_HOST=localhost
VADMON_PORT=3306
VADMON_DB=vadmon
VADMON_USER=
VADMON_PASSWORD=

# Valor de gcBaseEncrypt en _main.prg (secreto: pedirlo al administrador, no subirlo al repositorio).
VADMON_BASE_ENCRYPT=

# Carpeta conta\plantillas del sistema VFP (cuentas de Inversión del presupuesto por C.C.).
VFP_PLANTILLAS_DIR=C:\vfappn\admsys\conta\plantillas
# Respaldo si la plantilla no está accesible, formato cuenta:nombre;cuenta:nombre
PRESUPUESTO_CUENTAS_INVERSION=

# Franja que indica a qué base está conectada la web: desarrollo | pruebas | produccion.
# Dejar vacío (o borrar la línea) para no mostrarla, por ejemplo al publicar en producción.
ADMSYS_AMBIENTE=
